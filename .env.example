# Variáveis de ambiente locais do PetCare (copie para .env e preencha).
# O .env real é ignorado pelo git — nunca commitar tokens/segredos.

# Token fine-grained do GitHub (Settings → Developer settings → Fine-grained tokens)
# Permissões necessárias: Pull requests (Read and write) e Contents (Read) neste repositório.
GITHUB_PERSONAL_ACCESS_TOKEN=
